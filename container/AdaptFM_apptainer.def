Bootstrap: docker
From: nvidia/cuda:12.6.3-runtime-ubuntu24.04

%environment
    # Conda activation
    export PATH="/opt/miniforge/envs/AdaptFM/bin:/opt/miniforge/bin:$PATH"
    . /opt/miniforge/etc/profile.d/conda.sh
    conda activate AdaptFM

    # Force Qt to use PyQt6 and X11/XCB for WSL2 / Apptainer stability
    export QT_API="pyqt6"
    export QT_QPA_PLATFORM="xcb"
    export DISABLE_QT_PLUGIN_PATH=1
    
    # Software OpenGL fallback for WSL2 hardware driver passthrough issues
    export LIBGL_ALWAYS_INDIRECT=0

%post
    export DEBIAN_FRONTEND=noninteractive

    # 1. Install System dependencies, Qt6 OpenGL backends, and Mesa DRI drivers
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        wget \
        ca-certificates \
        libglib2.0-0 \
        mesa-utils \
        libgl1-mesa-dri \
        libglx-mesa0 \
        libegl1 \
        libdbus-1-3 \
        libxkbcommon-x11-0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-xinerama0 \
        libxcb-xinput0 \
        libxcb-xfixes0 \
        libxcb-cursor0 \
        libxcb-shape0 \
        libopengl0 \
        libfontconfig1 \
        libxrender1 \
        libxi6 \
        x11-utils \
        && rm -rf /var/lib/apt/lists/*

    # 2. Install Miniforge
    wget "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh" -O /tmp/miniforge.sh
    bash /tmp/miniforge.sh -b -p /opt/miniforge
    rm /tmp/miniforge.sh

    export PATH="/opt/miniforge/bin:$PATH"
    . /opt/miniforge/etc/profile.d/conda.sh

    # 3. Create Conda Environment with PyQt6 & CUDA 12.6 PyTorch
    conda create -n AdaptFM python=3.12 pyqt6 -c conda-forge -y
    conda activate AdaptFM

    pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cu126

    # 4. Clone and Install AdaptFM
    # Note: Ensure public clone or pass access credentials at build-time
    git clone https://github.com/Zhao-Lab-UW-DHO/AdaptFM.git /opt/AdaptFM
    cd /opt/AdaptFM
    pip install -e .

%runscript
    exec python -m AdaptFM.dev_launch "$@"

%labels
    Author ZhaoLab
    Version 1.0
    Description Apptainer image for AdaptFM with CUDA 12.6, PyQt6, and WSL OpenGL fixes